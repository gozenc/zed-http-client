  {
    "label": "HTTP Client: Copy Request as cURL",
    "command": "node \"$HOME/repos/zed-http-client/scripts/zed-rest-client.mjs\" curl --file \"$ZED_FILE\" --line \"$ZED_ROW\" --cwd \"$ZED_WORKTREE_ROOT\" | pbcopy && echo 'Copied request as cURL.'",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["http-request"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
